# Copy this to .env (gitignored — never commit real secrets) and fill in real values before
# running:
#   docker compose --profile full up -d --build
#
# NOT included here on purpose: DB_HOST, DB_PORT, KAFKA_BOOTSTRAP_SERVERS, REDIS_HOST,
# BACKEND_URI — those are Docker network topology (service names), hardcoded directly in
# docker-compose.yml's `environment:` blocks for the backend/gateway services, not secrets a
# deployer should be editing.

#---------------- Postgres ----------------
DB_NAME=nexcart
DB_USER=nexcart_user
DB_PASSWORD=change-me-to-a-strong-password

#---------------- JWT signing secret ----------------
# Generate with: openssl rand -base64 48
APP_SECURITY_JWT_SECRET=change-this-to-a-long-random-value

#---------------- CORS ----------------
# Mostly vestigial in production — the frontend's own nginx reverse-proxies /api/v1/* to the
# gateway internally, so the browser never sends a cross-origin request. Still exercised by
# local dev (ng serve on :4200 talking directly to the gateway on :8081).
APP_SECURITY_CORS_ALLOWED_ORIGINS=http://localhost:4200

# Leave false on a plain-HTTP deployment — a Secure cookie set over HTTP is silently dropped
# by the browser. Only flip to true once TLS is in front of this stack.
APP_SECURITY_REFRESH_COOKIE_SECURE=false

#---------------- Backblaze B2 (S3-compatible product image storage) ----------------
B2_ENDPOINT=
B2_REGION=us-west-004
B2_BUCKET=
B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=

#---------------- Email (Resend SMTP relay) ----------------
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=

#---------------- Payments (Razorpay test/sandbox keys) ----------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
